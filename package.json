{
  "name": "airport-auto",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts e2e vite.config.ts playwright.config.ts",
    "format": "prettier --write src scripts e2e *.md *.json *.ts .github/workflows/*.yml",
    "test": "npm run test:surface && npm run test:simulation && npm run test:trajectories && npm run test:collisions",
    "test:e2e": "playwright test",
    "test:surface": "node scripts/validateSurfaceGraphs.mjs",
    "test:simulation": "node scripts/validateFixedStep.mjs",
    "test:trajectories": "node scripts/validateFlightTrajectories.mjs",
    "test:collisions": "node scripts/validateCollisionEnvelopes.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/three": "^0.180.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.7"
  }
}
